# ── Supabase PostgreSQL (get from Supabase → Settings → Database) ──
# Use the "Transaction" pooling URL for DATABASE_URL
DATABASE_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Use the "Session" / direct URL for DIRECT_URL
DIRECT_URL="postgresql://postgres.[ref]:[password]@aws-0-ap-south-1.pooler.supabase.com:5432/postgres"

# ── App ──
PORT=3001
NODE_ENV=production

# ── Frontend URL (for CORS) ──
FRONTEND_URL=https://mulpath.vercel.app

# ── Blockchain (Sepolia) ──
SEPOLIA_RPC_URL=https://rpc.sepolia.org
PRIVATE_KEY=your_wallet_private_key_here
CONTRACT_ADDRESS=your_contract_address_here

# ── Cloudinary (for file uploads - free forever) ──
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
